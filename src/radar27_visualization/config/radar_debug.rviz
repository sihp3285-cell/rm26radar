Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Static Scene1
        - /Static Scene1/Topic1
        - /Static Scene1/Namespaces1
        - /Pose Debug1
        - /Pose Debug1/Topic1
        - /Tracker Debug1
        - /Tracker Debug1/Topic1
        - /Guesser Debug1
        - /Guesser Debug1/Topic1
      Splitter Ratio: 0.5199999809265137
    Tree Height: 425
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
        camera_link:
          Value: true
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        world:
          camera_link:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Static Scene
      Namespaces:
        radar/blind_zones/area: true
        radar/blind_zones/boundary: true
        radar/blind_zones/text: true
        radar/camera: true
        radar/field_grid: true
        radar/fov: true
        radar/mesh: true
        radar/nav_grid/obstacle: true
        radar/nav_grid/reachable: true
        radar/nav_grid/unreachable: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /radar/rviz/static
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Pose Debug
      Namespaces:
        radar/measurement_text: true
        radar/measurements: true
        radar/ray_hits: true
        radar/rays: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /radar/rviz/pose
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tracker Debug
      Namespaces:
        radar/covariance: true
        radar/robots: true
        radar/track_text: true
        radar/tracks: true
        radar/trajectory: true
        radar/velocity: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /radar/rviz/tracker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Guesser Debug
      Namespaces:
        radar/guess_candidates/accepted: true
        radar/guess_candidates/text: true
        radar/main_guess: true
        radar/main_guess/link: true
        radar/main_guess/text: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /radar/rviz/guesser
      Value: true
  Enabled: true
  Global Options:
    Background Color: 28; 31; 38
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 32.44839096069336
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0.6000000238418579
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: -0.5197972059249878
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 1.6868304014205933
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1403
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Views:
    collapsed: false
  Width: 2560
  X: 2560
  Y: 0
